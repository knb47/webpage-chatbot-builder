# Demo stack env — copy to .env.demo and fill in the two <...> values.
# Everything else works out of the box against LocalStack.

# Django
DJANGO_ENV=production                       # selects the real (non-mock) views/tasks
DJANGO_SETTINGS_MODULE=backend.settings.demo
DJANGO_SECRET_KEY=local-demo-not-secret
CELERY_LOG_LEVEL=INFO
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://

# Postgres (compose service)
DB_NAME=chapp
DB_USER=chapp
DB_PASSWORD=chapp
DB_HOST=postgres
DB_PORT=5432

# LocalStack ("AWS")
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566        # as seen from inside compose
AWS_PUBLIC_ENDPOINT_URL=http://localhost:4566  # as seen from the browser
AWS_REGION=us-east-1
AWS_S3_REGION_NAME=us-east-1
AWS_ACCOUNT_ID=000000000000
AWS_STORAGE_BUCKET_NAME=chapp-tenant-configs
LAMBDA_EXECUTION_ROLE=arn:aws:iam::000000000000:role/chapp-lambda-execution

# From `terraform output api_gateway_id` (infra/terraform)
EXISTING_API_GATEWAY_ID=<terraform-output-api-gateway-id>

# LLM key injected into each tenant Lambda
ANTHROPIC_API_KEY=<your-anthropic-api-key>
